# ===== Telegram =====
BOT_TOKEN=123456:REPLACE_WITH_REAL_TOKEN
USE_WEBHOOK=false
WEBHOOK_URL=https://example.com
WEBHOOK_PATH=/webhook/REPLACE_WITH_RANDOM_SEGMENT
WEBHOOK_SECRET=REPLACE_WITH_HIGH_ENTROPY_SECRET
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
DROP_PENDING_UPDATES=true

# Comma-separated Telegram user IDs that become bootstrap admins
ADMIN_IDS=

# ===== Anonymity encryption =====
# Fernet key (urlsafe base64, 32 bytes). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ANON_ENC_KEY=REPLACE_WITH_FERNET_KEY

# ===== PostgreSQL =====
POSTGRES__HOST=localhost
POSTGRES__PORT=5432
POSTGRES__USER=anticor
POSTGRES__PASSWORD=REPLACE_WITH_DB_PASSWORD
POSTGRES__DB=anticor

# ===== Redis =====
REDIS__HOST=localhost
REDIS__PORT=6379
REDIS__PASSWORD=
REDIS__DB=0

# ===== App =====
DEBUG=false
DEFAULT_LOCALE=ru
